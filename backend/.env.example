# Postgres connection (BE-03)
DATABASE_URL=postgres://dlottery:dlottery@localhost:5432/dlottery

# Blockchain RPC endpoint (BE-02)
RPC_URL=http://localhost:8545

# Deployed DLottery contract address (lowercased internally)
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Block the contract was deployed at; the indexer starts scanning here.
START_BLOCK=0

# Confirmations before a log is treated as final (BE-09)
CONFIRMATIONS=3
# How far to rewind on a detected reorg (BE-10)
REORG_DEPTH=12
# Max block span per eth_getLogs call
MAX_BLOCK_RANGE=2000
# Poll interval in seconds
POLL_INTERVAL_SECS=5

# REST API bind address (BE-04)
HTTP_ADDR=0.0.0.0:8080

# Log filter
RUST_LOG=info,dlottery_backend=debug,sqlx=warn
