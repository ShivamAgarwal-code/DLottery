# Copy to backend/.env.neon and fill DATABASE_URL. The real file is gitignored.
#
# Use the Neon DIRECT (unpooled) connection string - hostname WITHOUT "-pooler".
# A long-running sqlx server keeps its own pool and runs migrations, so direct is
# correct (pooled/PgBouncer transaction mode breaks prepared statements + migrations).
# Keep ?sslmode=require; drop channel_binding for driver compatibility.
#   neon connection-string production   ->   strip "&channel_binding=require"
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Sepolia deployment
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=0xB8f3f30C26588a9914a575A3e9105F57F6D7BA95
START_BLOCK=12033152
CONFIRMATIONS=3
REORG_DEPTH=12
MAX_BLOCK_RANGE=2000
POLL_INTERVAL_SECS=10
HTTP_ADDR=0.0.0.0:8080
RUST_LOG=info,dlottery_backend=debug,sqlx=warn
