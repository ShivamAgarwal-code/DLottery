# Testnet deployment credentials (used by `npm run deploy:sepolia`).
# Copy to .env and fill in. NEVER commit real keys - .env is gitignored.

# A Sepolia RPC endpoint (e.g. from Alchemy, Infura, or a public one).
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Private key of a testnet account funded with a little Sepolia ETH (from a faucet).
# Use a throwaway/dev key only - never a key that holds real mainnet funds.
PRIVATE_KEY=0xyour_testnet_private_key

# Optional: for contract verification on Etherscan.
ETHERSCAN_API_KEY=

# Optional deploy params (defaults shown).
TICKET_PRICE=10
MIN_PARTICIPANTS=2
# DAO_ADDRESS defaults to the deployer if unset.
